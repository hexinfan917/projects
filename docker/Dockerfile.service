# Python微服务基础镜像
FROM petway-base:latest

ARG SERVICE_NAME

WORKDIR /app

# 复制服务requirements
COPY backend/${SERVICE_NAME}/requirements.txt ./service-requirements.txt
RUN pip install --no-cache-dir -r service-requirements.txt || true

# 复制代码
COPY backend/common ./common
COPY backend/${SERVICE_NAME} ./

# 设置Python路径
ENV PYTHONPATH=/app

# 暴露端口
EXPOSE 8000

# 启动命令
CMD ["python", "-m", "uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
